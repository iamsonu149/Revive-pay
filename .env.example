DATABASE_URL="file:./dev.db"
# Run npm run auth:setup to generate merchant credentials in .env.
# MERCHANT_USER=merchant
# MERCHANT_PASSWORD=<generated locally; minimum 16 characters>
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx

# Optional server-only AI Recovery Analyst. Get a key locally from Google AI Studio.
# Never prefix this variable with NEXT_PUBLIC_ or paste a key into chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
