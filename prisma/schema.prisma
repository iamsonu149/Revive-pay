generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  phone         String
  riskBand      String
  createdAt     DateTime         @default(now())
  subscriptions Subscription[]
  attempts      PaymentAttempt[]
  contacts      ContactEvent[]
}

model Subscription {
  id              String           @id @default(cuid())
  customerId      String
  planName        String
  amount          Int
  status          String
  nextBillingDate DateTime
  provider        String           @default("mock")
  providerSubscriptionId String?
  customer        Customer         @relation(fields: [customerId], references: [id])
  attempts        PaymentAttempt[]

  @@unique([provider, providerSubscriptionId])
}

model PaymentAttempt {
  id                       String        @id @default(cuid())
  subscriptionId           String
  customerId               String
  amount                   Int
  status                   String
  failureReason            String
  attemptedAt              DateTime
  retryCount               Int
  paymentMethodAgeDays     Int
  recentSuccessfulPayments Int
  bankHealthScore          Int
  customerEngagementScore  Int
  contactCountLast7Days    Int
  provider                 String        @default("mock")
  providerPaymentId        String?
  providerOrderId          String?
  subscription             Subscription  @relation(fields: [subscriptionId], references: [id])
  customer                 Customer      @relation(fields: [customerId], references: [id])
  recoveryCase             RecoveryCase?

  @@unique([provider, providerPaymentId])
}

model RecoveryCase {
  id                           String             @id @default(cuid())
  paymentAttemptId             String             @unique
  predictedRecoveryProbability Int
  recommendedAction            String
  reasonSummary                String
  evidence                     String
  status                       String             @default("PENDING_APPROVAL")
  requiresHumanApproval        Boolean
  approvedAmount               Int?
  scheduledFor                 DateTime?
  recoveredAmount              Int                @default(0)
  recoveredAt                  DateTime?
  rejectedAt                   DateTime?
  rejectionReason              String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  paymentAttempt               PaymentAttempt     @relation(fields: [paymentAttemptId], references: [id])
  events                       AuditEvent[]
  execution                    RecoveryExecution?
  analyses                     RecoveryAnalysis[]
  webhookEvents                ProviderWebhookEvent[]
}

model AuditEvent {
  id             String        @id @default(cuid())
  recoveryCaseId String?
  eventType      String
  actor          String
  payload        String
  createdAt      DateTime      @default(now())
  recoveryCase   RecoveryCase? @relation(fields: [recoveryCaseId], references: [id])
}

model ContactEvent {
  id             String   @id @default(cuid())
  customerId     String
  reservationKey String   @unique
  createdAt      DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
}

model RecoveryExecution {
  id                String       @id
  recoveryCaseId    String       @unique
  action            String
  status            String       @default("CLAIMED")
  providerReference String?
  provider           String       @default("mock")
  providerStatus     String?
  recoveryUrl        String?
  lastErrorCode      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  recoveryCase      RecoveryCase @relation(fields: [recoveryCaseId], references: [id])

  @@index([provider, providerReference])
}

model ProviderWebhookEvent {
  id              String        @id
  provider        String
  providerEventId String?
  eventType       String
  signatureValid  Boolean
  status          String
  payloadHash     String
  recoveryCaseId  String?
  errorCode       String?
  duplicateCount  Int           @default(0)
  processingLatencyMs Int?
  retryStatus     String        @default("NOT_REQUIRED")
  deadLetter      Boolean       @default(false)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  recoveryCase    RecoveryCase? @relation(fields: [recoveryCaseId], references: [id])

  @@index([provider, providerEventId])
  @@index([recoveryCaseId, receivedAt])
}

model MockProviderOperation {
  id        String   @id
  paymentId String
  action    String
  outcome   String
  reference String
  createdAt DateTime @default(now())
}

model SimulationRun {
  id                     String   @id @default(cuid())
  strategyName           String
  totalPayments          Int
  failuresDetected       Int
  recoveredCount         Int
  recoveredAmount        Int
  retryAttempts          Int
  messagesSent           Int
  avoidedBadRetries      Int
  customerAnnoyanceScore Int
  estimatedRetryCost      Int      @default(0)
  estimatedContactCost    Int      @default(0)
  expectedRiskLoss        Int      @default(0)
  estimatedChurnImpact    Int      @default(0)
  netRecoveredValue       Int      @default(0)
  recoveryPerRetry        Int      @default(0)
  recoveryPerContact      Int      @default(0)
  customersProtected      Int      @default(0)
  approvalWorkload        Int      @default(0)
  unsafeRetriesAttempted  Int      @default(0)
  replayId                String?
  seed                    Int?
  createdAt              DateTime @default(now())
}

model Setting {
  id                String   @id @default("merchant")
  autoRecoveryLimit Int      @default(10000)
  maxContacts       Int      @default(2)
  killSwitch        Boolean  @default(false)
  maxRetries        Int      @default(1)
  minRecoveryScore  Int      @default(0)
  minPaymentAmount  Int      @default(100)
  approvalAmountThreshold Int @default(10000)
  quietHoursStart   Int      @default(22)
  quietHoursEnd     Int      @default(8)
  retryDelayHours   Int      @default(24)
  allowedRecoveryActions String @default("[\"RETRY_LATER\",\"SEND_PAYMENT_UPDATE_LINK\"]")
  neverRetryFailureReasons String @default("[\"CANCELLED_SUBSCRIPTION\",\"REFUND\",\"SUSPECTED_CHARGEBACK\",\"CHARGEBACK\"]")
  updatedAt         DateTime @updatedAt
}

model SafetyLabRun {
  id              String   @id @default(cuid())
  scenario        String
  injected        String
  expectedInvariant String
  timeline        String
  requestsReceived Int
  accepted        Int
  duplicatesRejected Int
  providerActions Int
  finalState      String
  auditEvents     Int
  passed          Boolean
  createdAt       DateTime @default(now())
}

model SafetyLabClaim {
  id        String   @id
  runId     String
  createdAt DateTime @default(now())

  @@index([runId])
}

model SafeDemoBatch {
  id                       String              @id
  requestId                String              @unique
  status                   String              @default("RUNNING")
  casesEvaluated           Int                 @default(0)
  actionsExecuted          Int                 @default(0)
  confirmedRecoveryCount   Int                 @default(0)
  confirmedRecoveryAmount  Int                 @default(0)
  declinedOrUnresolved     Int                 @default(0)
  blockedByPolicy          Int                 @default(0)
  unsafeActionsPrevented   Int                 @default(0)
  requiresApproval         Int                 @default(0)
  createdAt                DateTime            @default(now())
  completedAt              DateTime?
  items                    SafeDemoBatchCase[]
}

model SafeDemoBatchCase {
  id              String        @id @default(cuid())
  batchId         String
  recoveryCaseId  String
  action          String
  result          String        @default("PENDING")
  recoveredAmount Int           @default(0)
  detail          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  batch           SafeDemoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, recoveryCaseId])
  @@index([recoveryCaseId])
}

model RecoveryAnalysis {
  id                    String       @id @default(cuid())
  recoveryCaseId        String
  requestId             String       @unique
  status                String       @default("RUNNING")
  source                String?
  model                 String?
  requestedModel        String?
  promptVersion         String
  evidenceFingerprint   String
  evidenceJson          String
  analysisJson          String?
  policyJson            String?
  fallbackReason        String?
  createdAt             DateTime     @default(now())
  completedAt           DateTime?
  recoveryCase          RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([recoveryCaseId, createdAt])
}

model AnalysisBudget {
  id           String   @id @default("merchant")
  windowStart  DateTime
  requestCount Int      @default(0)
}
